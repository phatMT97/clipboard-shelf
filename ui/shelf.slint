import { Button, VerticalBox, ScrollView } from "std-widgets.slint";

export struct ShelfCardData {
    id: string,
    title: string,
    preview: string,
    icon: string,
    time: string,
    item_type: string,
    pinned: bool,
    has_more: bool,
    thumbnail: image,
}

export component MainWindow inherits Window {
    title: "Clipboard Shelf";
    icon: @image-url("../assets/app_icon.png");
    width: 410px;
    height: 600px;
    always-on-top: true;
    background: #1e1e24;

    in-out property <[ShelfCardData]> items: [];
    in-out property <int> item_count: 0;
    in-out property <int> selected_index: 0;
    in-out property <bool> is_always_on_top: true;
    in-out property <length> scroll_viewport_y: 0px;

    // Continuous reorder state
    in-out property <int> reorder_from: -1;
    in-out property <int> reorder_to: -1;
    in-out property <bool> is_reordering: false;
    in-out property <length> drag_mouse_viewport_y: -1px;

    in-out property <string> active_filter: "all";
    in-out property <string> search_text: "";
    in-out property <int> expanded_index: -1;
    in-out property <bool> is_ole_dragging: false;
    in-out property <int> ole_dragging_index: -1;
    in-out property <bool> show_all_expanded: false;
    in-out property <int> copied_flash_index: -1;
    in-out property <bool> auto_hide_enabled: false;
    in-out property <string> current_locale: "vi"; // "vi" or "en"

    callback copy_item(string, int);
    callback pin_item(string, int);
    callback delete_item(string, int);
    callback start_drag_item(string, int);
    callback move_item(int, int);
    callback clear_all();
    callback add_shelf_item(ShelfCardData);
    callback filter_changed(string, string);
    callback refresh_shelf();
    callback toggle_auto_hide();
    callback toggle_language();

    // Left edge dock handle indicator (visible when docked against right screen edge)
    Rectangle {
        x: 0px;
        y: 40px;
        width: 3.5px;
        height: root.height - 80px;
        background: root.auto_hide_enabled ? #00e5ff : transparent;
        border-radius: 2px;
        opacity: root.auto_hide_enabled ? 0.75 : 0.0;
        animate opacity { duration: 150ms; }
    }

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        // Header / Action Bar
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // Left: Clean item counter
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                horizontal-stretch: 1;

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: #2d2d38;
                    border-radius: 4px;
                    Text {
                        text: root.item_count;
                        color: #60cdff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Text {
                    text: root.current_locale == "en" ? 
                        (root.item_count == 1 ? "1 item" : (root.item_count + " items")) : 
                        (root.item_count + " mục");
                    color: #9a9ab0;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }

            // Language switch toggle button (VI / EN)
            Rectangle {
                width: 32px;
                height: 24px;
                background: lang-touch.has-hover ? #3e3e52 : #2d2d38;
                border-radius: 4px;
                border-width: 1px;
                border-color: lang-touch.has-hover ? #60cdff : #383848;
                animate background, border-color { duration: 120ms; }
                lang-touch := TouchArea {
                    clicked => {
                        root.toggle_language();
                    }
                }
                Text {
                    text: root.current_locale == "en" ? "EN" : "VI";
                    font-size: 11px;
                    font-weight: 700;
                    color: root.current_locale == "en" ? #60cdff : #fbbf24;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Expand all toggle button with clear text
            Rectangle {
                width: 84px;
                height: 24px;
                background: expand-all-touch.has-hover ? #3c3c50 : (root.show_all_expanded ? #18385c : #2d2d38);
                border-radius: 4px;
                border-width: 1px;
                border-color: root.show_all_expanded ? #4cc2ff : #383848;
                animate background, border-color { duration: 150ms; }
                expand-all-touch := TouchArea {
                    clicked => {
                        root.show_all_expanded = !root.show_all_expanded;
                    }
                }
                Text {
                    text: root.show_all_expanded ?
                        (root.current_locale == "en" ? "▲ Collapse" : "▲ Thu gọn") :
                        (root.current_locale == "en" ? "▼ Expand" : "▼ Xem hết");
                    font-size: 10px;
                    font-weight: 600;
                    color: root.show_all_expanded ? #60cdff : #b0b0c4;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Auto-hide edge dock toggle button
            Rectangle {
                width: 78px;
                height: 24px;
                background: auto-hide-touch.has-hover ? (root.auto_hide_enabled ? #204474 : #3c3c50) : (root.auto_hide_enabled ? #183358 : #2d2d38);
                border-radius: 4px;
                border-width: 1px;
                border-color: root.auto_hide_enabled ? #4cc2ff : #383848;
                animate background, border-color { duration: 150ms; }
                auto-hide-touch := TouchArea {
                    clicked => {
                        root.toggle_auto_hide();
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    // Vector Icon for Auto-Hide / Dock
                    Rectangle {
                        width: 13px;
                        height: 11px;
                        y: (parent.height - self.height) / 2;

                        // Outer screen frame
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 13px;
                            height: 11px;
                            border-radius: 2px;
                            border-width: 1.2px;
                            border-color: root.auto_hide_enabled ? #60cdff : #a0a0b8;
                            background: transparent;

                            // Right docked shelf strip
                            Rectangle {
                                x: 7.5px;
                                y: 1.2px;
                                width: 3.2px;
                                height: 8.6px;
                                border-radius: 0.8px;
                                background: root.auto_hide_enabled ? #60cdff : (auto-hide-touch.has-hover ? #707086 : #48485a);
                            }

                            // Left main screen area line indicator
                            Rectangle {
                                x: 2px;
                                y: 3.5px;
                                width: 3.5px;
                                height: 1.2px;
                                border-radius: 0.5px;
                                background: root.auto_hide_enabled ? #3a6898 : #48485a;
                            }
                            Rectangle {
                                x: 2px;
                                y: 6.2px;
                                width: 4.2px;
                                height: 1.2px;
                                border-radius: 0.5px;
                                background: root.auto_hide_enabled ? #3a6898 : #48485a;
                            }
                        }
                    }

                    Text {
                        text: root.auto_hide_enabled ?
                            (root.current_locale == "en" ? "Auto-hide" : "Tự ẩn") :
                            (root.current_locale == "en" ? "Pinned" : "Luôn mở");
                        font-size: 10px;
                        font-weight: 600;
                        color: root.auto_hide_enabled ? #60cdff : #b0b0c4;
                        vertical-alignment: center;
                    }
                }
            }

            // Clear all unpinned button
            Rectangle {
                width: 28px;
                height: 24px;
                background: clear-touch.has-hover ? #c42b1c : #2d2d38;
                border-radius: 4px;
                border-width: 1px;
                border-color: clear-touch.has-hover ? #e81123 : #383848;
                animate background, border-color { duration: 150ms; }
                clear-touch := TouchArea {
                    clicked => { root.clear_all(); }
                }

                // Centered Trash Can Vector Icon (14px x 14px centered inside 28px x 24px button)
                Rectangle {
                    width: 14px;
                    height: 14px;

                    // Lid handle
                    Rectangle {
                        x: 5px;
                        y: 0px;
                        width: 4px;
                        height: 1.5px;
                        background: clear-touch.has-hover ? #ffffff : #a0a0b4;
                        border-radius: 0.5px;
                    }
                    // Lid
                    Rectangle {
                        x: 1px;
                        y: 2px;
                        width: 12px;
                        height: 2px;
                        background: clear-touch.has-hover ? #ffffff : #a0a0b4;
                        border-radius: 1px;
                    }
                    // Can body
                    Rectangle {
                        x: 2px;
                        y: 4.5px;
                        width: 10px;
                        height: 9px;
                        background: transparent;
                        border-width: 1.5px;
                        border-color: clear-touch.has-hover ? #ffffff : #a0a0b4;
                        border-bottom-left-radius: 2px;
                        border-bottom-right-radius: 2px;
                    }
                }
            }
        }

        // Live Search Bar
        Rectangle {
            height: 32px;
            background: #252530;
            border-radius: 6px;
            border-width: 1px;
            border-color: search-input.has-focus ? #4cc2ff : #363646;
            animate border-color { duration: 150ms; }

            if root.search_text == "" && !search-input.has-focus : Text {
                x: 30px;
                y: 8px;
                text: root.current_locale == "en" ? "Search clipboard..." : "Tìm kiếm nội dung...";
                font-size: 11.5px;
                color: #6a6a7c;
                vertical-alignment: center;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                Text {
                    text: "🔍";
                    font-size: 12px;
                    vertical-alignment: center;
                    color: #88889a;
                }

                search-input := TextInput {
                    text <=> root.search_text;
                    font-size: 12px;
                    color: #ffffff;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    edited => {
                        root.filter_changed(root.active_filter, self.text);
                    }
                }

                if root.search_text != "" : Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: clear-search.has-hover ? #3e3e50 : transparent;
                    y: 6px;
                    clear-search := TouchArea {
                        clicked => {
                            root.search_text = "";
                            root.filter_changed(root.active_filter, "");
                        }
                    }
                    Text {
                        text: "×";
                        font-size: 13px;
                        font-weight: 700;
                        color: #a0a0b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Category Filter Chips Bar
        HorizontalLayout {
            spacing: 5px;
            height: 24px;

            // All Chip
            Rectangle {
                border-radius: 12px;
                background: (root.active_filter == "all") ? #0078d4 : (chip-all.has-hover ? #2e2e3c : #242430);
                border-width: 1px;
                border-color: (root.active_filter == "all") ? #4cc2ff : #363646;
                animate background, border-color { duration: 120ms; }
                chip-all := TouchArea {
                    clicked => {
                        root.active_filter = "all";
                        root.filter_changed("all", root.search_text);
                    }
                }
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text {
                        text: root.current_locale == "en" ? "All" : "Tất cả";
                        font-size: 10.5px;
                        font-weight: (root.active_filter == "all") ? 700 : 500;
                        color: (root.active_filter == "all") ? #ffffff : #a0a0b4;
                        vertical-alignment: center;
                    }
                }
            }

            // Text Chip
            Rectangle {
                border-radius: 12px;
                background: (root.active_filter == "text") ? #183358 : (chip-text.has-hover ? #2e2e3c : #242430);
                border-width: 1px;
                border-color: (root.active_filter == "text") ? #60cdff : #363646;
                animate background, border-color { duration: 120ms; }
                chip-text := TouchArea {
                    clicked => {
                        root.active_filter = "text";
                        root.filter_changed("text", root.search_text);
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.current_locale == "en" ? "📝 Text" : "📝 Chữ";
                        font-size: 10.5px;
                        font-weight: (root.active_filter == "text") ? 700 : 500;
                        color: (root.active_filter == "text") ? #60cdff : #a0a0b4;
                        vertical-alignment: center;
                    }
                }
            }

            // Links Chip
            Rectangle {
                border-radius: 12px;
                background: (root.active_filter == "url") ? #321c54 : (chip-url.has-hover ? #2e2e3c : #242430);
                border-width: 1px;
                border-color: (root.active_filter == "url") ? #b892ff : #363646;
                animate background, border-color { duration: 120ms; }
                chip-url := TouchArea {
                    clicked => {
                        root.active_filter = "url";
                        root.filter_changed("url", root.search_text);
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.current_locale == "en" ? "🔗 Links" : "🔗 Link";
                        font-size: 10.5px;
                        font-weight: (root.active_filter == "url") ? 700 : 500;
                        color: (root.active_filter == "url") ? #b892ff : #a0a0b4;
                        vertical-alignment: center;
                    }
                }
            }

            // Files Chip
            Rectangle {
                border-radius: 12px;
                background: (root.active_filter == "files") ? #3c2910 : (chip-files.has-hover ? #2e2e3c : #242430);
                border-width: 1px;
                border-color: (root.active_filter == "files") ? #fbbf24 : #363646;
                animate background, border-color { duration: 120ms; }
                chip-files := TouchArea {
                    clicked => {
                        root.active_filter = "files";
                        root.filter_changed("files", root.search_text);
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.current_locale == "en" ? "📁 Files" : "📁 Tệp";
                        font-size: 10.5px;
                        font-weight: (root.active_filter == "files") ? 700 : 500;
                        color: (root.active_filter == "files") ? #fbbf24 : #a0a0b4;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Shelf item list
        scroll-view := ScrollView {
            vertical-stretch: 1;
            content-y <=> root.scroll_viewport_y;
            content-x: 0px;

            VerticalLayout {
                spacing: 8px;
                padding-right: 4px;

                if root.item_count == 0 : Rectangle {
                    height: 130px;
                    background: #252530;
                    border-radius: 8px;
                    Text {
                        text: root.current_locale == "en" ?
                            "Copy anything to get started\n(Text, Files, Links, Screenshots)" :
                            "Sao chép bất kỳ nội dung nào\n(Text, File, Link, Ảnh) để bắt đầu";
                        color: #727288;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for item[i] in root.items : card := Rectangle {
                    property <bool> is_expanded: root.show_all_expanded || root.expanded_index == i;
                    property <bool> card_drag_started: false;
                    height: (item.item_type == "image") ? (is_expanded ? 300px : 156px) : (is_expanded ? 260px : 124px);
                    animate height { duration: 120ms; }
                    opacity: (root.is_reordering && root.reorder_from == i) ? 0.6 : 1.0;
                    background: (root.is_reordering && root.reorder_from == i) ?
                        #1c3050 :
                        ((root.is_ole_dragging && root.ole_dragging_index == i) ?
                            #102544 :
                            ((root.copied_flash_index == i) ?
                                #0c3322 :
                                ((i == root.selected_index) ?
                                    (card-touch.has-hover ? #223652 : #1a2a40) :
                                    (card-touch.has-hover ? #2a2a38 : #21212c))));
                    border-radius: 8px;
                    border-width: ((root.is_reordering && root.reorder_from == i) || (root.is_ole_dragging && root.ole_dragging_index == i) || (root.copied_flash_index == i)) ?
                        2px :
                        ((i == root.selected_index || item.pinned) ? 1.5px : 1px);
                    border-color: (root.is_reordering && root.reorder_from == i) ?
                        #00e5ff :
                        ((root.is_ole_dragging && root.ole_dragging_index == i) ?
                            #00e5ff :
                            ((root.copied_flash_index == i) ?
                                #10b981 :
                                (item.pinned ? #3e5a88 : ((i == root.selected_index) ? #4cc2ff : (card-touch.has-hover ? #48485c : #30303e)))));
                    animate background, border-color { duration: 120ms; }

                    // Drop target insertion bar indicator
                    if root.is_reordering && root.reorder_to == i && root.reorder_from != i : Rectangle {
                        x: 2px;
                        y: (root.reorder_to > root.reorder_from) ? (card.height - 6px) : 0px;
                        width: card.width - 4px;
                        height: 6px;
                        background: #00e5ff;
                        border-radius: 3px;
                    }

                    // Left selection indicator accent pill
                    if i == root.selected_index : Rectangle {
                        x: 0px;
                        y: 10px;
                        width: 3.5px;
                        height: card.height - 20px;
                        background: (root.copied_flash_index == i) ? #10b981 : #4cc2ff;
                        border-top-right-radius: 3px;
                        border-bottom-right-radius: 3px;
                    }

                    // Card body touch area
                    card-touch := TouchArea {
                        scroll-event(event) => { reject }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                card.card_drag_started = false;
                            }
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                card.card_drag_started = false;
                                if (root.is_ole_dragging) {
                                    root.is_ole_dragging = false;
                                    root.ole_dragging_index = -1;
                                }
                            }
                        }
                        clicked => {
                            card.card_drag_started = false;
                            root.is_ole_dragging = false;
                            root.ole_dragging_index = -1;
                            if (!root.is_reordering) {
                                root.selected_index = i;
                                root.copy_item(item.id, i);
                            }
                        }
                        moved => {
                            if (!root.is_reordering && !root.is_ole_dragging && !card.card_drag_started && self.pressed && (
                                (self.mouse-x - self.pressed-x) > 28px ||
                                (self.mouse-x - self.pressed-x) < -28px ||
                                (self.mouse-y - self.pressed-y) > 28px ||
                                (self.mouse-y - self.pressed-y) < -28px
                            )) {
                                card.card_drag_started = true;
                                root.is_ole_dragging = true;
                                root.ole_dragging_index = i;
                                root.start_drag_item(item.id, i);
                            }
                        }
                    }

                    // Prominent OLE Dragging Overlay Banner
                    if root.is_ole_dragging && root.ole_dragging_index == i : Rectangle {
                        background: #102544f8;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: #00e5ff;

                        VerticalLayout {
                            alignment: center;
                            spacing: 5px;
                            Text {
                                text: root.current_locale == "en" ?
                                    "🚀 DRAGGING TO ANOTHER APPLICATION" :
                                    "🚀 ĐANG KÉO THẢ SANG ỨNG DỤNG KHÁC";
                                color: #00e5ff;
                                font-size: 12px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.current_locale == "en" ?
                                    "Drop into Notepad, Word, Browser, Explorer... to paste instantly" :
                                    "Thả chuột vào Notepad, Word, Browser, Explorer... để dán ngay";
                                color: #d0e4ff;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 7px;

                        // Reorder drag grip handle
                        Rectangle {
                            width: 20px;
                            height: card.height - 16px;
                            background: grip-touch.has-hover ? #2e3e5c : (root.is_reordering && root.reorder_from == i ? #364d78 : transparent);
                            border-radius: 4px;

                            grip-touch := TouchArea {
                                mouse-cursor: (root.is_reordering && root.reorder_from == i) ? grabbing : grab;
                                scroll-event(event) => { reject }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.reorder_from = i;
                                        root.reorder_to = i;
                                        root.is_reordering = true;
                                        root.selected_index = i;
                                        let mouse_list_y = card.y + self.mouse-y;
                                        root.drag_mouse_viewport_y = mouse_list_y + root.scroll_viewport_y;
                                    }
                                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                        root.drag_mouse_viewport_y = -1px;
                                        if (root.is_reordering) {
                                            let from = root.reorder_from;
                                            let to = root.reorder_to;
                                            root.is_reordering = false;
                                            root.reorder_from = -1;
                                            root.reorder_to = -1;
                                            if (from >= 0 && to >= 0 && from != to) {
                                                root.move_item(from, to);
                                            }
                                        }
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.is_reordering) {
                                        let mouse_list_y = card.y + self.mouse-y;
                                        let vy = mouse_list_y + root.scroll_viewport_y;
                                        root.drag_mouse_viewport_y = vy;
                                        let slot_h: length = card.is_expanded ? 268px : 132px;
                                        let target_idx = Math.max(0, Math.min(root.item_count - 1, Math.round(mouse_list_y / slot_h)));
                                        root.reorder_to = target_idx;
                                    }
                                }
                            }

                            Text {
                                text: "⠿";
                                color: (root.is_reordering && root.reorder_from == i) ? #00e5ff : (grip-touch.has-hover ? #60cdff : (i == root.selected_index ? #8aa2cf : #54546c));
                                font-size: 15px;
                                font-weight: (root.is_reordering && root.reorder_from == i) ? 800 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Main Card Content Column
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            // Card Top Header: Category Badge + Status Flash + Controls (Time, Reorder Up/Down, Pin, Delete)
                            HorizontalLayout {
                                height: 20px;
                                spacing: 6px;

                                Text {
                                    text: item.icon;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                // Type Badge Pill: TEXT / LINK / FILE
                                Rectangle {
                                    width: 34px;
                                    height: 16px;
                                    y: 2px;
                                    border-radius: 3px;
                                    background: (item.item_type == "text") ? #182638 :
                                                ((item.item_type == "url") ? #281c3e :
                                                ((item.item_type == "files") ? #2d2212 :
                                                ((item.item_type == "image") ? #11281e : #252532)));
                                    border-width: 1px;
                                    border-color: (item.item_type == "text") ? #2c4264 :
                                                  ((item.item_type == "url") ? #422d6e :
                                                  ((item.item_type == "files") ? #4a361c :
                                                  ((item.item_type == "image") ? #1e4231 : #383848)));

                                    Text {
                                        text: (item.item_type == "text") ? "TEXT" :
                                              ((item.item_type == "url") ? "LINK" :
                                              ((item.item_type == "files") ? "FILE" :
                                              ((item.item_type == "image") ? "IMG" : "CLIP")));
                                        color: (item.item_type == "text") ? #60cdff :
                                               ((item.item_type == "url") ? #b892ff :
                                               ((item.item_type == "files") ? #fbbf24 :
                                               ((item.item_type == "image") ? #34d399 : #9a9ab0)));
                                        font-size: 8px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Status Flash or flexible spacer
                                if root.copied_flash_index == i : Text {
                                    text: root.current_locale == "en" ?
                                        "✓ COPIED TO CLIPBOARD!" :
                                        "✓ ĐÃ SAO CHÉP VÀO CLIPBOARD!";
                                    color: #34d399;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                if root.copied_flash_index != i : Rectangle {
                                    horizontal-stretch: 1;
                                }

                                // Right Action Group: Time + Step Up/Down + Pin + Delete (Completely isolated, no overlap!)
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 4px;

                                    Text {
                                        text: item.time;
                                        color: #727288;
                                        font-size: 9.5px;
                                        vertical-alignment: center;
                                    }

                                    // Quick step move up
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: up-touch.has-hover ? #344872 : #242430;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: up-touch.has-hover ? #4cc2ff : #343444;
                                        opacity: i > 0 ? 1.0 : 0.25;
                                        up-touch := TouchArea {
                                            enabled: i > 0;
                                            clicked => {
                                                root.selected_index = i - 1;
                                                root.move_item(i, i - 1);
                                            }
                                        }
                                        Text {
                                            text: "▲";
                                            color: up-touch.has-hover ? #60cdff : #90a0be;
                                            font-size: 7.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Quick step move down
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: down-touch.has-hover ? #344872 : #242430;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: down-touch.has-hover ? #4cc2ff : #343444;
                                        opacity: i + 1 < root.item_count ? 1.0 : 0.25;
                                        down-touch := TouchArea {
                                            enabled: i + 1 < root.item_count;
                                            clicked => {
                                                root.selected_index = i + 1;
                                                root.move_item(i, i + 1);
                                            }
                                        }
                                        Text {
                                            text: "▼";
                                            color: down-touch.has-hover ? #60cdff : #90a0be;
                                            font-size: 7.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Pin toggle button
                                    Rectangle {
                                        width: 20px;
                                        height: 18px;
                                        background: pin-touch.has-hover ? #3c3c52 : (item.pinned ? #243550 : #242430);
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: item.pinned ? #4cc2ff : (pin-touch.has-hover ? #505068 : #343444);
                                        pin-touch := TouchArea {
                                            clicked => { root.pin_item(item.id, i); }
                                        }
                                        Text {
                                            text: "📌";
                                            font-size: 9.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            opacity: item.pinned ? 1.0 : 0.6;
                                        }
                                    }

                                    // Delete button
                                    Rectangle {
                                        width: 20px;
                                        height: 18px;
                                        background: del-touch.has-hover ? #d83b01 : #242430;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: del-touch.has-hover ? #ff4d4d : #343444;
                                        del-touch := TouchArea {
                                            clicked => { root.delete_item(item.id, i); }
                                        }
                                        Text {
                                            text: "×";
                                            color: del-touch.has-hover ? #ffffff : #88889c;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Card Content Container: Full Copied Content Displayed Prominently!
                            Rectangle {
                                background: #161622;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #272738;

                                VerticalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    spacing: 4px;

                                    // 1. Image Thumbnail display for screenshot/copied images
                                    if item.item_type == "image" : VerticalLayout {
                                        spacing: 4px;
                                        Rectangle {
                                            height: card.is_expanded ? 210px : 86px;
                                            background: #101018;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #242436;
                                            clip: true;

                                            Image {
                                                source: item.thumbnail;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: contain;
                                            }
                                        }

                                        HorizontalLayout {
                                            Text {
                                                text: item.preview;
                                                color: #88889e;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }

                                            expand-img-touch := TouchArea {
                                                width: 24px;
                                                height: 16px;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (card.is_expanded) {
                                                        if (root.show_all_expanded) {
                                                            root.show_all_expanded = false;
                                                        }
                                                        root.expanded_index = -1;
                                                        root.scroll_viewport_y = 0px;
                                                    } else {
                                                        root.expanded_index = i;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 15px;
                                                    border-radius: 3px;
                                                    background: expand-img-touch.has-hover ? #2e3e56 : #20202e;
                                                    border-width: 1px;
                                                    border-color: expand-img-touch.has-hover ? #60cdff : #303044;

                                                    Text {
                                                        text: card.is_expanded ? "▲" : "▼";
                                                        color: expand-img-touch.has-hover ? #60cdff : #8e9bb0;
                                                        font-size: 8px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 2. Text / Link / Files content display (collapsed)
                                    if item.item_type != "image" && !card.is_expanded : VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: item.preview;
                                            color: #ffffff;
                                            font-size: 13.5px;
                                            font-weight: 500;
                                            wrap: word-wrap;
                                            max-lines: 3;
                                            overflow: elide;
                                        }

                                        if item.has_more : HorizontalLayout {
                                            alignment: end;
                                            expand-touch := TouchArea {
                                                width: 24px;
                                                height: 16px;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.expanded_index = i;
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 15px;
                                                    border-radius: 3px;
                                                    background: expand-touch.has-hover ? #2e3e56 : #20202e;
                                                    border-width: 1px;
                                                    border-color: expand-touch.has-hover ? #60cdff : #303044;
                                                    animate background, border-color { duration: 100ms; }

                                                    Text {
                                                        text: "▼";
                                                        color: expand-touch.has-hover ? #60cdff : #8e9bb0;
                                                        font-size: 8px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 3. Text / Link / Files content display (expanded)
                                    if item.item_type != "image" && card.is_expanded : VerticalLayout {
                                        spacing: 3px;
                                        expanded-scroll := ScrollView {
                                            height: 185px;
                                            content-x: 0px;
                                            VerticalLayout {
                                                width: expanded-scroll.visible-width;
                                                padding-left: 2px;
                                                padding-right: 4px;
                                                Text {
                                                    text: item.preview;
                                                    color: #ffffff;
                                                    font-size: 13.5px;
                                                    font-weight: 500;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: end;
                                            collapse-touch := TouchArea {
                                                width: 24px;
                                                height: 16px;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.show_all_expanded) {
                                                        root.show_all_expanded = false;
                                                    }
                                                    root.expanded_index = -1;
                                                    root.scroll_viewport_y = 0px;
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 15px;
                                                    border-radius: 3px;
                                                    background: collapse-touch.has-hover ? #2e3e56 : #20202e;
                                                    border-width: 1px;
                                                    border-color: collapse-touch.has-hover ? #60cdff : #303044;
                                                    animate background, border-color { duration: 100ms; }

                                                    Text {
                                                        text: "▲";
                                                        color: collapse-touch.has-hover ? #60cdff : #8e9bb0;
                                                        font-size: 8px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Footer hint
        HorizontalLayout {
            Text {
                text: root.is_reordering ?
                    (root.current_locale == "en" ?
                        ("📍 Moving card [" + (root.reorder_from + 1) + "] ➔ Position [" + (root.reorder_to + 1) + "] (Release mouse to place)") :
                        ("📍 Đang di chuyển thẻ [" + (root.reorder_from + 1) + "] ➔ Vị trí [" + (root.reorder_to + 1) + "] (Thả chuột để đặt)")) :
                    (root.current_locale == "en" ?
                        "💡 Drag ⠿ to reorder  |  Click ▲/▼ to jump  |  Drag cards directly into Notepad/Word" :
                        "💡 Kéo ⠿ đổi thứ tự  |  Bấm ▲/▼ đổi nấc  |  Kéo thẻ thả trực tiếp vào Notepad/Word");
                color: root.is_reordering ? #4cc2ff : #6a6a80;
                font-size: 10px;
                font-weight: root.is_reordering ? 700 : 400;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}
