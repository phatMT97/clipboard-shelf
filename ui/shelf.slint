import { Button, VerticalBox, ScrollView } from "std-widgets.slint";

export struct ShelfCardData {
    id: string,
    title: string,
    preview: string,
    icon: string,
    time: string,
    item_type: string,
    pinned: bool,
}

export component MainWindow inherits Window {
    title: "Clipboard Shelf";
    width: 340px;
    height: 560px;
    always-on-top: true;
    background: #1e1e24;

    in-out property <[ShelfCardData]> items: [];
    in-out property <int> item_count: 0;
    in-out property <int> selected_index: 0;
    in-out property <bool> is_always_on_top: true;

    // Continuous reorder state
    in-out property <int> reorder_from: -1;
    in-out property <int> reorder_to: -1;
    in-out property <bool> is_reordering: false;

    callback copy_item(string, int);
    callback pin_item(string, int);
    callback delete_item(string, int);
    callback start_drag_item(string, int);
    callback move_item(int, int);
    callback clear_all();
    callback add_shelf_item(ShelfCardData);

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        // Header
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "📋 Clipboard Shelf";
                color: #ffffff;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 24px;
                height: 24px;
                background: #2d2d38;
                border-radius: 4px;
                Text {
                    text: root.item_count;
                    color: #9a9ab0;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                width: 28px;
                height: 24px;
                background: clear-touch.has-hover ? #e81123 : #2d2d38;
                border-radius: 4px;
                animate background { duration: 150ms; }
                clear-touch := TouchArea {
                    clicked => { root.clear_all(); }
                }
                Text {
                    text: "🗑️";
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // Shelf item list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;
                padding-right: 4px;

                if root.item_count == 0 : Rectangle {
                    height: 130px;
                    background: #252530;
                    border-radius: 8px;
                    Text {
                        text: "Sao chép bất kỳ nội dung nào\n(Text, File, Link, Ảnh) để bắt đầu";
                        color: #727288;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for item[i] in root.items : Rectangle {
                    height: 74px;
                    background: (root.is_reordering && root.reorder_from == i) ?
                        #2b3d62 :
                        ((i == root.selected_index) ?
                            (card-touch.has-hover ? #2c3954 : #222e44) :
                            (card-touch.has-hover ? #2c2c3d : #232330));
                    border-radius: 8px;
                    border-width: (root.is_reordering && root.reorder_from == i) ? 2px : ((i == root.selected_index || item.pinned) ? 1.5px : 1px);
                    border-color: (root.is_reordering && root.reorder_from == i) ?
                        #60cdff :
                        (item.pinned ? #60cdff : ((i == root.selected_index) ? #3a86ff : #363646));
                    animate background, border-color { duration: 120ms; }

                    // Drop target insertion bar indicator
                    if root.is_reordering && root.reorder_to == i && root.reorder_from != i : Rectangle {
                        x: 4px;
                        y: (root.reorder_to > root.reorder_from) ? 70px : 1px;
                        width: 310px;
                        height: 3px;
                        background: #4cc2ff;
                        border-radius: 1.5px;
                    }

                    // Left selection indicator accent pill
                    if i == root.selected_index : Rectangle {
                        x: 0px;
                        y: 12px;
                        width: 3.5px;
                        height: 50px;
                        background: #4cc2ff;
                        border-top-right-radius: 3px;
                        border-bottom-right-radius: 3px;
                    }

                    // Card body touch area (handles selection, re-copy, and deliberate OLE drag to external apps)
                    card-touch := TouchArea {
                        clicked => {
                            if (!root.is_reordering) {
                                root.selected_index = i;
                                root.copy_item(item.id, i);
                            }
                        }
                        moved => {
                            // Only trigger OLE drag if not currently reordering and mouse moved beyond 12px
                            if (!root.is_reordering && self.pressed && (
                                (self.mouse-x - self.pressed-x) > 12px ||
                                (self.mouse-x - self.pressed-x) < -12px ||
                                (self.mouse-y - self.pressed-y) > 12px ||
                                (self.mouse-y - self.pressed-y) < -12px
                            )) {
                                root.start_drag_item(item.id, i);
                            }
                        }
                    }

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // Reorder drag grip handle (supports continuous multi-slot drag and drop)
                        Rectangle {
                            width: 18px;
                            height: 56px;
                            background: grip-touch.has-hover ? #34405a : (root.is_reordering && root.reorder_from == i ? #3a4c70 : transparent);
                            border-radius: 4px;
                            y: 1px;

                            grip-touch := TouchArea {
                                mouse-cursor: row-resize;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.reorder_from = i;
                                        root.reorder_to = i;
                                        root.is_reordering = true;
                                        root.selected_index = i;
                                    }
                                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                        if (root.is_reordering) {
                                            if (root.reorder_from >= 0 && root.reorder_to >= 0 && root.reorder_from != root.reorder_to) {
                                                root.move_item(root.reorder_from, root.reorder_to);
                                            }
                                            root.is_reordering = false;
                                            root.reorder_from = -1;
                                            root.reorder_to = -1;
                                        }
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.is_reordering) {
                                        let delta = self.mouse-y - self.pressed-y;
                                        let offset: int = (delta > 0px) ?
                                            ((delta + 41px) / 82px) :
                                            ((delta - 41px) / 82px);
                                        root.reorder_to = Math.max(0, Math.min(root.item_count - 1, root.reorder_from + offset));
                                    }
                                }
                            }

                            Text {
                                text: "⠿";
                                color: (root.is_reordering && root.reorder_from == i) ? #4cc2ff : (grip-touch.has-hover ? #60cdff : (i == root.selected_index ? #8aa2cf : #5e5e74));
                                font-size: 16px;
                                font-weight: (root.is_reordering && root.reorder_from == i) ? 800 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Type icon box
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            background: (i == root.selected_index) ? #1a2436 : #1a1a22;
                            border-radius: 6px;
                            y: 10px;

                            Text {
                                text: item.icon;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Content preview
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            HorizontalLayout {
                                Text {
                                    text: item.title;
                                    color: (i == root.selected_index) ? #ffffff : #e2e2ec;
                                    font-size: 12px;
                                    font-weight: (i == root.selected_index) ? 700 : 600;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: item.time;
                                    color: (i == root.selected_index) ? #82a8ec : #66667a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: (root.is_reordering && root.reorder_from == i && root.reorder_to != i) ?
                                    ("📍 Thả để chuyển sang vị trí " + (root.reorder_to + 1)) :
                                    item.preview;
                                color: (root.is_reordering && root.reorder_from == i && root.reorder_to != i) ?
                                    #60cdff :
                                    ((i == root.selected_index) ? #b0c4de : #9494a8);
                                font-size: 11px;
                                font-weight: (root.is_reordering && root.reorder_from == i && root.reorder_to != i) ? 700 : 400;
                                overflow: elide;
                                max-lines: 2;
                            }
                        }

                        // Actions column: 2x2 grid (Pin & Delete, Move Up & Move Down)
                        HorizontalLayout {
                            spacing: 3px;
                            width: 44px;

                            VerticalLayout {
                                spacing: 3px;
                                width: 20px;

                                // Pin button
                                Rectangle {
                                    width: 20px;
                                    height: 26px;
                                    background: pin-touch.has-hover ? #3c3c50 : transparent;
                                    border-radius: 4px;
                                    pin-touch := TouchArea {
                                        clicked => { root.pin_item(item.id, i); }
                                    }
                                    Text {
                                        text: item.pinned ? "📌" : "📍";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Delete button
                                Rectangle {
                                    width: 20px;
                                    height: 26px;
                                    background: del-touch.has-hover ? #e81123 : transparent;
                                    border-radius: 4px;
                                    del-touch := TouchArea {
                                        clicked => { root.delete_item(item.id, i); }
                                    }
                                    Text {
                                        text: "✕";
                                        color: del-touch.has-hover ? #ffffff : #888899;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                width: 20px;

                                // Move Up button
                                Rectangle {
                                    width: 20px;
                                    height: 26px;
                                    background: up-touch.has-hover ? #344872 : (i == 0 ? #1a1a24 : #242938);
                                    border-radius: 4px;
                                    opacity: i > 0 ? 1.0 : 0.25;
                                    up-touch := TouchArea {
                                        enabled: i > 0;
                                        clicked => {
                                            root.selected_index = i - 1;
                                            root.move_item(i, i - 1);
                                        }
                                    }
                                    Text {
                                        text: "▲";
                                        color: up-touch.has-hover ? #60cdff : #90a0be;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Move Down button
                                Rectangle {
                                    width: 20px;
                                    height: 26px;
                                    background: down-touch.has-hover ? #344872 : (i + 1 == root.item_count ? #1a1a24 : #242938);
                                    border-radius: 4px;
                                    opacity: i + 1 < root.item_count ? 1.0 : 0.25;
                                    down-touch := TouchArea {
                                        enabled: i + 1 < root.item_count;
                                        clicked => {
                                            root.selected_index = i + 1;
                                            root.move_item(i, i + 1);
                                        }
                                    }
                                    Text {
                                        text: "▼";
                                        color: down-touch.has-hover ? #60cdff : #90a0be;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Footer hint
        HorizontalLayout {
            Text {
                text: root.is_reordering ?
                    ("📍 Đang di chuyển thẻ [" + (root.reorder_from + 1) + "] ➔ Vị trí [" + (root.reorder_to + 1) + "] (Thả chuột để đặt)") :
                    "💡 Kéo ⠿ đến bất kỳ vị trí nào rồi thả  |  Bấm ▲/▼ để đổi từng nấc";
                color: root.is_reordering ? #4cc2ff : #6a6a80;
                font-size: 11px;
                font-weight: root.is_reordering ? 700 : 400;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}
